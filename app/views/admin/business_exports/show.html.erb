<% content_for :title, "Geschäfte exportieren" %>
<% content_for :admin_detail_header do %>
  <header class="admin-detail-header">
    <div class="min-w-0">
      <%= link_to admin_stores_path, class: "admin-action-link text-xs" do %>
        <%= heroicon "chevron-left", options: { class: "h-3.5 w-3.5", "aria-hidden": true } %>
        Alle Geschäfte
      <% end %>
      <h1 class="mt-1 text-xl font-semibold tracking-tight">Geschäfte exportieren</h1>
      <p class="mt-1 text-sm text-base-content/60"><%= @export.rows.size %> Einträge in der Vorschau</p>
    </div>
    <%= link_to download_admin_business_export_path(sort: @export.sort, status: @export.status), class: "btn btn-primary btn-sm rounded-lg", data: { turbo: false } do %>
      <%= heroicon "arrow-down-tray", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": true } %>
      Excel herunterladen
    <% end %>
  </header>
<% end %>

<section class="admin-detail-section" aria-labelledby="export-settings-heading">
  <h2 id="export-settings-heading">Export einstellen</h2>
  <%= form_with url: admin_business_export_path, method: :get, class: "mt-5 grid items-end gap-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]" do %>
    <div>
      <%= label_tag :sort, "Sortierung", class: "field-label" %>
      <%= select_tag :sort, options_for_select(BusinessExport::SORT_OPTIONS.map { |value, label| [label, value] }, @export.sort), class: "field-input" %>
    </div>
    <div>
      <%= label_tag :status, "Statusfilter", class: "field-label" %>
      <%= select_tag :status, options_for_select([["Alle Status", ""]] + BusinessExport::STATUS_LABELS.map { |value, label| [label, value] }, @export.status), class: "field-input" %>
    </div>
    <%= submit_tag "Vorschau aktualisieren", class: "admin-list-button" %>
  <% end %>
  <p class="mt-3 text-xs text-base-content/50">Die Vorschau und die Excel-Datei enthalten dieselben Einträge in derselben Reihenfolge.</p>
</section>

<section class="admin-detail-section mt-6" aria-labelledby="export-preview-heading">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="export-preview-heading">Vorschau</h2>
    <p class="text-xs text-base-content/50"><%= @export.rows.size %> Einträge</p>
  </div>
  <% if @export.rows.any? %>
    <div class="mt-5 overflow-x-auto">
      <table class="admin-table table">
        <thead>
          <tr>
            <% BusinessExport::HEADERS.each do |header| %>
              <th><%= header %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @export.rows.each do |row| %>
            <tr>
              <% row.each do |value| %>
                <td class="min-w-40 whitespace-pre-line align-top"><%= value %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="admin-list-empty mt-5">Keine Geschäfte für diesen Status gefunden.</p>
  <% end %>
</section>
