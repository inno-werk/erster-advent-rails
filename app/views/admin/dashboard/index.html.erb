<%= content_for :title, "Dashboard" %>

<%= render "admin/shared/page_header",
title: "Dashboard",
subtitle: "Überblick über Geschäfte und Benutzer." %>

<section class="flex flex-wrap divide-x divide-base-200 border-y border-base-200">
  <% @metrics.each do |metric| %>
    <div class="min-w-[160px] flex-1 px-6 py-5 first:pl-0">
      <div class="flex items-center gap-1.5">
        <%= heroicon metric[:icon], options: { class: "w-4 h-4 shrink-0 text-base-content/40" } %>
        <p class="admin-eyebrow"><%= metric[:label] %></p>
      </div>
      <p class="mt-2 font-frank font-light text-4xl text-primary">
        <%= number_with_delimiter(metric[:value]) %>
      </p>
    </div>
  <% end %>
</section>

<section class="mt-12">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="font-jakarta font-bold text-xl md:text-2xl">Zu prüfende Geschäfte</h2>
      <p class="admin-subtitle mt-1">
        Neu registrierte Geschäfte, die auf eine Prüfung warten.
      </p>
    </div>
    <%= link_to admin_stores_path(status: "pending"), class: "admin-action-link" do %>
      Alle Geschäfte
      <%= heroicon "arrow-right", options: { class: "w-4 h-4" } %>
    <% end %>
  </div>

  <%= render "admin/stores/list", businesses: @recent_businesses %>
</section>
