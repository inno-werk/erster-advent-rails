<% content_for :title, "Rechnungen versenden" %>
<% content_for :topbar do %>
  <%= render "app/shared/topbar", crumbs: [["Zahlungen", admin_participations_path(year: @year, payment_status: "pending")], ["Rechnungen versenden", nil]],
    actions: link_to("Zurück zu den Zahlungen", admin_participations_path(year: @year, payment_status: "pending"), class: "admin-list-button") %>
<% end %>
<% total_cents = @recipients.sum(&:amount_cents) %>
<% recipients_label = "#{@recipients.size} #{@recipients.size == 1 ? "Geschäft" : "Geschäfte"}" %>
<% checks = [
  [@recipients.any?, "Offene Zahlungen vorhanden", @recipients.any? ? "#{recipients_label} mit total #{invoice_chf(total_cents)}" : "Für #{@year} ist nichts offen."],
  [!@editing_text, "Betreff und Text festgelegt", @editing_text ? "Bitte zuerst in Schritt 2 speichern oder abbrechen." : (@invoice_text.persisted? ? "Gespeicherter Text wird verwendet." : "Standardtext wird verwendet.")],
  [@setting_ready, "Bankverbindung gespeichert", @setting_ready ? "#{@setting.bank_name} – #{InvoiceSetting.formatted_iban(@setting.iban)}" : "In Schritt 2 prüfen und speichern."],
  [@problems.empty?, "Angaben aller Empfänger vollständig", @problems.empty? ? "Name und Rechnungsadresse vorhanden." : "#{@problems.size} #{@problems.size == 1 ? "Geschäft" : "Geschäfte"} in Schritt 3 ergänzen."],
  [@delivery_enabled, "E-Mail-Versand aktiv", @delivery_enabled ? "E-Mails werden wirklich versendet." : "PROD_SEND ist nicht true – Versand nicht möglich."],
  [!@in_progress, "Kein Versand in Bearbeitung", @in_progress ? "Bitte warten, bis der laufende Versand abgeschlossen ist." : "Bereit für einen neuen Versand."]
] %>
<% can_send = checks.all?(&:first) %>


<div class="mx-auto max-w-6xl space-y-6" data-controller="invoice-steps">
  <header>
    <h1 class="text-2xl font-semibold tracking-tight">Rechnungen versenden <%= @year %></h1>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-base-content/60">In vier Schritten: Übersicht lesen, Text und Rechnung prüfen, Empfänger kontrollieren und zum Schluss bestätigen und senden.</p>
  </header>

  <% flash.each do |type, message| %>
    <div role="alert" class="alert <%= type.to_s == "notice" ? "alert-success" : "alert-error" %> text-sm"><%= message %></div>
  <% end %>

  <%# 1 — Overview and history %>
  <%= render layout: "step", locals: { number: 1, title: "Übersicht", hint: "Was beim Versand passiert und bisherige Versände",
    status: @runs.any? ? "#{@runs.size} #{@runs.size == 1 ? "Versand" : "Versände"}" : "Noch kein Versand", tone: "neutral" } do %>
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="admin-step-label">So funktioniert es</h2>
        <ul class="space-y-3 text-sm leading-relaxed">
          <% [
            ["user-group", "Jedes Geschäft mit offenem Teilnahmebeitrag #{@year} erhält eine E-Mail an seine Konto-E-Mail-Adresse."],
            ["banknotes", "Der Betrag entspricht der offenen Zahlung: CHF 200 (Kat. A), 250 (Kat. B), 100 (Kat. C) oder die offene Differenz nach einem Wechsel."],
            ["document-text", "Im Anhang liegt die Rechnung als PDF mit QR-Einzahlungsschein."],
            ["shield-check", "Wer vor dem Versand bezahlt, erhält keine Rechnung. Bereits versendete Rechnungen werden nie doppelt verschickt."]
          ].each do |icon, text| %>
            <li class="flex gap-3">
              <%= heroicon icon, variant: :outline, options: { class: "mt-0.5 h-5 w-5 shrink-0 text-primary", "aria-hidden": true } %>
              <span><%= text %></span>
            </li>
          <% end %>
        </ul>
      </div>
      <div>
        <h2 class="admin-step-label">Bisherige Versände <%= @year %></h2>
        <% if @runs.any? %>
          <ul class="divide-y divide-base-200 rounded-xl border border-base-300">
            <% @runs.each do |run| %>
              <% counts = ParticipationInvoice.statuses.keys.index_with { |status| @run_counts.fetch([run.id, status], 0) } %>
              <li>
                <%= link_to admin_invoice_run_path(run), class: "flex items-center gap-3 px-4 py-3 transition-colors hover:bg-base-200/60" do %>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm font-medium"><%= l(run.created_at, format: :short) %> – <%= run.subject %></span>
                    <span class="block truncate text-xs text-base-content/60"><%= run.created_by&.email || "unbekannt" %></span>
                  </span>
                  <span class="flex shrink-0 flex-wrap justify-end gap-1">
                    <span class="badge badge-soft badge-success badge-sm"><%= counts["sent"] %>/<%= counts.values.sum %> versendet</span>
                    <% if counts["failed"].positive? %><span class="badge badge-soft badge-error badge-sm"><%= counts["failed"] %> fehlgeschlagen</span><% end %>
                    <% if (counts["queued"] + counts["sending"]).positive? %><span class="badge badge-soft badge-info badge-sm">läuft</span><% end %>
                  </span>
                  <%= heroicon "chevron-right", variant: :outline, options: { class: "h-4 w-4 shrink-0 text-base-content/40", "aria-hidden": true } %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="rounded-xl border border-dashed border-base-300 px-4 py-6 text-center text-sm text-base-content/60">Für <%= @year %> wurden noch keine Rechnungen versendet.</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# 2 — Text, bank details and PDF preview %>
  <% step_two_status, step_two_tone = if @editing_text then [ "Text wird bearbeitet", "warning" ]
     elsif !@setting_ready then [ "Bankverbindung fehlt", "warning" ]
     else [ "Bereit", "success" ] end %>
  <%= render layout: "step", locals: { number: 2, target: "previewStep", title: "Inhalt & Vorschau", hint: "Betreff und Text prüfen, Bankverbindung kontrollieren, PDF ansehen",
    status: step_two_status, tone: step_two_tone } do %>
    <div class="grid items-start gap-8 xl:grid-cols-[minmax(300px,1fr)_minmax(0,1.3fr)]">
      <div class="space-y-6">
        <%= render "text" %>
        <div class="rounded-xl bg-base-200/60 p-4">
          <%= label_tag :participation_id, "Vorschau für", class: "field-label" %>
          <div class="flex flex-wrap gap-2">
            <%= select_tag :participation_id, options_for_select(@recipients.map { |recipient| ["#{recipient.name.presence || recipient.email} – #{invoice_chf(recipient.amount_cents)}", recipient.participation.id] }, params[:participation_id]),
              form: "invoice-run-form", class: "field-input min-w-0 flex-1", disabled: @recipients.empty?, data: { invoice_steps_target: "select" } %>
            <button type="submit" form="invoice-run-form" formaction="<%= preview_admin_invoice_runs_path %>" formtarget="invoice-preview" formnovalidate class="btn btn-outline btn-primary rounded-lg" <%= "disabled" if @recipients.empty? %>>
              <%= heroicon "arrow-path", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": true } %>
              Vorschau aktualisieren
            </button>
          </div>
          <p class="field-hint">Die Vorschau zeigt immer den gespeicherten Text.</p>
        </div>

        <section class="rounded-xl border border-base-300 p-4" aria-labelledby="bank-heading">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <h3 id="bank-heading" class="text-sm font-semibold">Bankverbindung</h3>
            <%= link_to "Im Menü öffnen", admin_invoice_setting_path, class: "admin-action-link text-xs" %>
          </div>
          <% if @setting_ready %>
            <p class="mt-2 text-sm leading-relaxed">
              <strong><%= @setting.bank_name %> – <%= InvoiceSetting.formatted_iban(@setting.iban) %></strong><br>
              <span class="text-base-content/70"><%= @setting.creditor_name %> – <%= [@setting.street, @setting.building_number].compact_blank.join(" ") %> – <%= @setting.postal_code %> <%= @setting.town %></span>
            </p>
          <% else %>
            <p class="mt-2 text-sm text-warning">Noch nicht gespeichert. Bitte die vorausgefüllten Angaben prüfen und speichern.</p>
          <% end %>
          <details class="mt-3" <%= "open" unless @setting_ready %>>
            <summary class="cursor-pointer text-sm font-medium text-primary"><%= @setting_ready ? "Bankverbindung ändern" : "Bankverbindung erfassen" %></summary>
            <div class="mt-4"><%= render "admin/invoice_settings/form", setting: @setting, return_to: "invoice_run" %></div>
          </details>
        </section>
      </div>

      <div>
        <h3 class="admin-step-label">PDF-Vorschau</h3>
        <iframe data-invoice-steps-target="preview" name="invoice-preview" title="PDF-Vorschau der Rechnung" class="admin-letter-preview" src="<%= @recipients.any? && @setting.valid? ? preview_admin_invoice_runs_path : "about:blank" %>"></iframe>
      </div>
    </div>
  <% end %>

  <%# 3 — Recipients %>
  <%= render layout: "step", locals: { number: 3, title: "Empfänger prüfen", hint: "Alle Geschäfte mit offener Zahlung #{@year} und ihre Beträge",
    status: @problems.any? ? "#{@problems.size} mit fehlenden Angaben" : "#{recipients_label} · #{invoice_chf(total_cents)}", tone: @problems.any? ? "warning" : (@recipients.any? ? "success" : "neutral") } do %>
    <% if @problems.any? %>
      <div role="alert" class="alert alert-warning mb-5 flex-col items-start gap-2 text-sm">
        <p class="font-medium">Diese Geschäfte benötigen einen Namen und eine Rechnungsadresse (max. <%= ParticipationInvoice::MAX_ADDRESS_LINES %> Zeilen):</p>
        <ul class="list-disc pl-5">
          <% @problems.each do |recipient| %>
            <li><%= link_to recipient.name.presence || recipient.email, recipient.business ? edit_admin_store_path(recipient.business) : admin_user_path(recipient.user), class: "link" %> – <%= recipient.problem %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <% if @recipients.any? %>
      <div class="overflow-x-auto rounded-xl border border-base-300">
        <table class="table admin-table" data-testid="invoice-recipients">
          <thead><tr><th>Geschäft / Rechnungsadresse</th><th>E-Mail</th><th>Mitgliedschaft</th><th class="text-right">Betrag</th><th>Letzte Rechnung</th><th><span class="sr-only">Vorschau</span></th></tr></thead>
          <tbody>
            <% @recipients.each do |recipient| %>
              <tr class="<%= "bg-warning/10" if recipient.problem %>">
                <td>
                  <%= link_to recipient.name.presence || "Name fehlt", admin_user_path(recipient.user), class: "link link-primary" %>
                  <div class="text-xs text-base-content/60"><%= safe_join(recipient.address_lines, tag.br) %></div>
                  <% if recipient.problem %><div class="text-xs font-medium text-error"><%= recipient.problem %></div><% end %>
                </td>
                <td class="break-all"><%= recipient.email %></td>
                <td><%= invoice_category_label(recipient.category, recipient.previous_category) %></td>
                <td class="whitespace-nowrap text-right font-medium"><%= invoice_chf(recipient.amount_cents) %></td>
                <td class="whitespace-nowrap"><%= (sent_at = @last_sent_at[recipient.participation.id]) ? l(sent_at, format: :short) : "–" %></td>
                <td><button type="submit" form="invoice-run-form" formaction="<%= preview_admin_invoice_runs_path %>" formtarget="invoice-preview" formnovalidate name="participation_id" value="<%= recipient.participation.id %>" class="admin-action-link" data-action="invoice-steps#showPreview">Vorschau</button></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot><tr><th colspan="3">Total</th><th class="whitespace-nowrap text-right"><%= invoice_chf(total_cents) %></th><th colspan="2"></th></tr></tfoot>
        </table>
      </div>
    <% else %>
      <p class="rounded-xl border border-dashed border-base-300 px-4 py-6 text-center text-sm text-base-content/60">Keine offenen Zahlungen für <%= @year %>.</p>
    <% end %>
  <% end %>

  <%# 4 — Checks, confirmation and send %>
  <%= render layout: "step", locals: { number: 4, title: "Bestätigen & senden", hint: "Voraussetzungen prüfen und den Versand auslösen",
    status: can_send ? "Bereit zum Senden" : "Noch nicht bereit", tone: can_send ? "success" : "warning" } do %>
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="admin-step-label">Voraussetzungen</h2>
        <ul class="space-y-3" data-testid="invoice-checks">
          <% checks.each do |ok, label, detail| %>
            <li class="flex gap-3">
              <%= heroicon ok ? "check-circle" : "exclamation-triangle", variant: :solid, options: { class: "mt-0.5 h-5 w-5 shrink-0 #{ok ? "text-success" : "text-warning"}", "aria-hidden": true } %>
              <span>
                <span class="block text-sm font-medium"><%= label %><span class="sr-only"><%= ok ? ": erfüllt" : ": nicht erfüllt" %></span></span>
                <span class="block text-xs text-base-content/60"><%= detail %></span>
              </span>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="rounded-xl bg-base-200/60 p-5">
        <h2 class="admin-step-label">Zusammenfassung</h2>
        <dl class="grid grid-cols-2 gap-4" data-testid="invoice-summary">
          <div><dt class="text-xs text-base-content/60">Empfänger</dt><dd class="text-2xl font-semibold"><%= recipients_label %></dd></div>
          <div><dt class="text-xs text-base-content/60">Total</dt><dd class="text-2xl font-semibold"><%= invoice_chf(total_cents) %></dd></div>
        </dl>

        <%# The preview selection (steps 2 and 3) belongs to this form via form="invoice-run-form".
          The preview buttons submit it to another action, so it needs the session token, not a per-form token. %>
        <%= form_with url: admin_invoice_runs_path, method: :post, authenticity_token: form_authenticity_token, id: "invoice-run-form", class: "mt-5 space-y-4 border-t border-base-300 pt-5" do %>
          <%= hidden_field_tag :idempotency_key, @idempotency_key %>
          <%= hidden_field_tag :recipients_digest, @recipients_digest %>
          <%# The saved text the admin reviewed; the server refuses the run if it changed meanwhile. %>
          <%= hidden_field_tag :subject, @invoice_text.subject %>
          <%= hidden_field_tag :message, @invoice_text.message %>
          <label class="flex cursor-pointer items-start gap-3 text-sm">
            <%= check_box_tag :confirmed, "1", false, required: true, class: "checkbox checkbox-primary checkbox-sm mt-0.5", disabled: !can_send %>
            <span>Ich habe Text, Vorschau und Empfänger geprüft. Es werden sofort <strong><%= @recipients.size %> E-Mails</strong> über total <strong><%= invoice_chf(total_cents) %></strong> versendet.</span>
          </label>
          <button type="submit" class="btn btn-primary w-full rounded-lg" data-turbo-submits-with="Wird eingereiht …" <%= "disabled" unless can_send %>>
            <%= heroicon "paper-airplane", variant: :outline, options: { class: "h-4 w-4", "aria-hidden": true } %>
            Rechnungen an <%= recipients_label %> senden
          </button>
          <% unless can_send %>
            <p class="text-center text-xs text-base-content/60">Senden ist möglich, sobald alle Voraussetzungen erfüllt sind.</p>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
