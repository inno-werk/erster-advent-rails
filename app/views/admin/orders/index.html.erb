<%= render layout: "admin/shared/list", locals: { title: "Bestellungen", path: admin_orders_path, filters: [{ name: :status, label: "Status", value: @status, options: [["Alle Status", ""]] + @statuses.map { |status| [status, status] } }] } do %>
  <% if @orders.any? %>
      <table class="table admin-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Produkt</th>
            <th>Kunde</th>
            <th>Menge</th>
            <th>Größe</th>
            <th>Status</th>
            <th>Erstellt</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="hover:bg-base-200/50">
              <td><%= order.id %></td>
              <td class="font-normal"><%= order.product&.title || "-" %></td>
              <td><%= order.customer&.email || "-" %></td>
              <td><%= order.quantity %></td>
              <td><%= order.size %></td>
              <td><%= order.accept_order %></td>
              <td><%= l order.created_at, format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
  <% else %>
    <p class="admin-list-empty">Keine Bestellungen gefunden.</p>
  <% end %>
<% end %>
