<%= render layout: "admin/shared/list", locals: { title: "Produkte", path: admin_products_path, filters: [{ name: :sort, label: "Sortierung", value: @sort, default: "newest", options: [["Neueste zuerst", "newest"], ["Preis aufsteigend", "price_asc"], ["Preis absteigend", "price_desc"]] }] } do %>
  <% if @products.any? %>
      <table class="table admin-table">
        <thead>
          <tr>
            <th>Titel</th>
            <th>Geschäft</th>
            <th>Preis</th>
            <th>Bestellungen</th>
            <th>Erstellt</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <tr class="hover:bg-base-200/50">
              <td class="font-normal"><%= product.title %></td>
              <td><%= product.user&.business&.business_name || "-" %></td>
              <td><%= number_to_currency(product.price) %></td>
              <td><%= product.total_orders %></td>
              <td><%= l product.created_at, format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
  <% else %>
    <p class="admin-list-empty">Keine Produkte gefunden.</p>
  <% end %>
<% end %>
