<%# Admin page header, matching the storefront type system.
  Parameters:
  - title
  - subtitle (optional)
  - actions (optional block content rendered below the breadcrumb) %>

<header class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="admin-heading"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="admin-subtitle mt-1"><%= subtitle %></p>
    <% end %>
  </div>

  <div class="flex flex-col items-end gap-3">
    <nav class="admin-breadcrumb" aria-label="Breadcrumb">
      <%= link_to admin_root_path do %>
        <%= heroicon "home", options: { class: "w-4 h-4" } %>
      <% end %>
      <span>/</span>
      <span class="text-base-content/70"><%= title %></span>
    </nav>
    <% if local_assigns[:actions].present? %>
      <div class="flex flex-wrap items-center gap-2"><%= actions %></div>
    <% end %>
  </div>
</header>
