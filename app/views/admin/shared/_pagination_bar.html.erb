<%# Pagination footer shared by admin index pages: page nav on the left,
  a "per page" selector on the right that resubmits the current filters.
  Parameters:
  - pagy
  - path: the index path the per-page form submits to
  - extra_params: hash of other query params to preserve (optional) %>

<div class="mt-6 flex flex-wrap items-center justify-between gap-4">
  <div><%== pagy_nav(pagy) if pagy.pages > 1 %></div>

  <%= form_with url: path, method: :get, class: "flex items-center gap-2" do %>
    <% (local_assigns[:extra_params] || {}).each do |key, value| %>
      <%= hidden_field_tag key, value if value.present? %>
    <% end %>
    <label class="flex items-center gap-2 font-jakarta font-light text-sm text-base-content/60">
      <%= select_tag :per,
      options_for_select([ 10, 20, 50 ], pagy.vars[:items]),
      class: "select select-bordered select-sm rounded-full",
      onchange: "this.form.requestSubmit()" %>
      pro Seite
    </label>
  <% end %>
</div>
