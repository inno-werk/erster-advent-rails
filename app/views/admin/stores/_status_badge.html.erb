<% case status.to_sym %>
<% when :confirmed %>
  <span class="badge badge-soft badge-success gap-1">
    <%= heroicon "check-circle", options: { class: "w-3.5 h-3.5" } %>
    Bestätigt
  </span>
<% when :pending %>
  <span class="badge badge-soft badge-warning gap-1">
    <%= heroicon "clock", options: { class: "w-3.5 h-3.5" } %>
    Wartend
  </span>
<% when :rejected %>
  <span class="badge badge-soft badge-error gap-1">
    <%= heroicon "x-circle", options: { class: "w-3.5 h-3.5" } %>
    Abgelehnt
  </span>
<% else %>
  <span class="badge badge-soft badge-warning gap-1">Unbekannt</span>
<% end %>
