<%= render layout: "admin/shared/list", locals: { title: "Geschäfte", path: admin_stores_path, filters: [
  { name: :status, label: "Freigabe", value: @status, options: [["Alle Status", ""], ["Ausstehend", "pending"], ["Bestätigt", "confirmed"], ["Abgelehnt", "rejected"], ["Gelöscht", "deleted"]] },
  { name: :sort, label: "Sortierung", value: @sort, default: "name_asc", options: [["Name A–Z", "name_asc"], ["Name Z–A", "name_desc"]] }
] } do %>
  <% if @businesses.any? %>
        <table class="admin-table table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Inhaber</th>
              <th>Status</th>
              <th class="text-right">Aktionen</th>
            </tr>
          </thead>
          <tbody>
            <% @businesses.each do |business| %>
              <tr>
                <td>
                  <div class="flex items-center gap-3">
                    <span class="admin-row-icon">
                      <%= heroicon "building-storefront", options: { class: "w-4.5 h-4.5" } %>
                    </span>
                    <span class="font-normal"><%= business.business_name %></span>
                  </div>
                </td>
                <td><%= business.user&.email %></td>
                <td><%= render "admin/stores/status_badge", status: business.status %></td>
                <td class="text-right">
                  <%= link_to admin_store_path(business), class: "admin-action-link" do %>
                    <%= heroicon "document-text", options: { class: "w-4 h-4" } %>
                    Details
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
  <% else %>
    <p class="admin-list-empty">Keine Geschäfte gefunden.</p>
  <% end %>
<% end %>
