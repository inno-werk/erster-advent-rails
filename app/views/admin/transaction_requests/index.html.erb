<%= render layout: "admin/shared/list", locals: { title: "Transaktionsanfragen", path: admin_transaction_requests_path, filters: [{ name: :sort, label: "Sortierung", value: @sort, default: "newest", options: [["Neueste zuerst", "newest"], ["Älteste zuerst", "oldest"]] }] } do %>
  <% if @payments.any? %>
      <table class="table admin-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Kunde</th>
            <th>Plan</th>
            <th>Status</th>
            <th>Erstellt</th>
          </tr>
        </thead>
        <tbody>
          <% @payments.each do |payment| %>
            <tr class="hover:bg-base-200/50">
              <td><%= payment.id %></td>
              <td><%= payment.user&.email || payment.customer_email %></td>
              <td><%= payment.plan %></td>
              <td>
                <span class="badge badge-warning">
                  <%= payment.is_verified.presence || "Pending" %>
                </span>
              </td>
              <td><%= l payment.created_at, format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
  <% else %>
    <p class="admin-list-empty">Keine Transaktionsanfragen gefunden.</p>
  <% end %>
<% end %>
