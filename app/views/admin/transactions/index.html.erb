<%= render layout: "admin/shared/list", locals: { title: "Transaktionen", path: admin_transactions_path, filters: [{ name: :status, label: "Zahlungsstatus", value: @status, options: [["Alle Status", ""], ["Ausstehend", "pending"], ["Bestätigt", "approved"], ["Abgelehnt", "rejected"]] }] } do %>
  <% if @payments.any? %>
      <table class="table admin-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Kunde</th>
            <th>Plan</th>
            <th>Status</th>
            <th>Erstellt</th>
          </tr>
        </thead>
        <tbody>
          <% @payments.each do |payment| %>
            <tr class="hover:bg-base-200/50">
              <td><%= payment.id %></td>
              <td><%= payment.user&.email || payment.customer_email %></td>
              <td><%= payment.plan %></td>
              <td><%= payment.is_verified.presence || "Pending" %></td>
              <td><%= l payment.created_at, format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
  <% else %>
    <p class="admin-list-empty">Keine Transaktionen gefunden.</p>
  <% end %>
<% end %>
