<% sections = content_tag(:nav, class: "tabs tabs-border", aria: { label: "Benutzergruppen" }) do %>
  <%= link_to "Benutzer mit Geschäft", admin_users_path(section: "stores"), class: class_names("tab", "tab-active": @section == "stores"), aria: { current: (@section == "stores" ? "page" : nil) } %>
  <%= link_to "Admins", admin_users_path(section: "admins"), class: class_names("tab", "tab-active": @section == "admins"), aria: { current: (@section == "admins" ? "page" : nil) } %>
<% end %>
<%= render layout: "admin/shared/list", locals: { title: "Benutzer", path: admin_users_path, summary: sections, fixed_params: { section: @section }, filters: [
  { name: :confirmation, label: "E-Mail-Bestätigung", value: @confirmation, options: [["Alle", ""], ["Bestätigt", "confirmed"], ["Ausstehend", "pending"]] }
], actions: (current_user.superadmin? ? link_to("Benutzer hinzufügen", new_admin_user_path, class: "btn btn-primary btn-sm rounded-lg") : nil) } do %>
  <% if @users.any? %>
        <table class="admin-table table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Geschäft</th>
              <th>Rolle</th>
              <th class="text-right">Aktionen</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td>
                  <div class="flex items-center gap-3">
                    <span class="admin-row-icon">
                      <%= heroicon "user", options: { class: "w-4.5 h-4.5" } %>
                    </span>
                    <span class="font-normal"><%= user.name.presence || "-" %></span>
                  </div>
                </td>
                <td><%= user.email %></td>
                <td><%= user.business&.business_name || user.business_name || "-" %></td>
                <td><%= user.role_name %></td>
                <td>
                  <div class="flex justify-end gap-4">
                    <%= link_to admin_user_path(user), class: "admin-action-link" do %>
                      <%= heroicon "document-text", options: { class: "w-4 h-4" } %>
                      Details
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
  <% else %>
    <p class="admin-list-empty">Keine Benutzer gefunden.</p>
  <% end %>
<% end %>
