<%= content_for :title, @user.email %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <%= link_to admin_users_path,
  class: "inline-flex items-center gap-1 link-more text-sm md:text-base" do %>
    <%= heroicon "chevron-left", options: { class: "w-4 h-4" } %>
    Zurück zu allen Benutzern
  <% end %>

  <% unless @user.deleted? %>
    <%= button_to "Als Benutzer anmelden",
    impersonate_admin_user_path(@user),
    method: :post,
    class: "btn btn-primary rounded-full",
    data: {
      turbo_confirm: "Möchten Sie sich wirklich als #{@user.email} anmelden?",
    } %>
  <% end %>
</div>

<div class="w-full max-w-2xl">
  <% if @user.deleted? %>
    <div class="alert alert-warning mb-8 rounded-2xl" data-controller="dismiss">
      <%= heroicon "exclamation-triangle", options: { class: "w-5 h-5 shrink-0" } %>
      <span>Dieser Benutzer ist deaktiviert und kann nicht angemeldet werden.</span>
      <button
        type="button"
        data-action="dismiss#close"
        class="btn btn-ghost btn-square btn-sm"
        aria-label="Schliessen"
      >
        <%= heroicon "x-mark", options: { class: "w-4 h-4" } %>
      </button>
    </div>
  <% end %>

  <h1 class="font-jakarta font-bold text-2xl break-all"><%= @user.email %></h1>
  <p class="admin-subtitle mt-1">Benutzer #<%= @user.id %> · <%= @user.role_name %></p>

  <div class="mt-8 border-t border-base-200 pt-6">
    <p class="admin-eyebrow mb-3">Benutzerinformationen</p>
    <dl class="divide-y divide-base-200 font-jakarta">
      <div class="flex items-center justify-between gap-4 py-3">
        <dt class="font-light text-base-content/60">Name</dt>
        <dd><%= @user.name.presence || "-" %></dd>
      </div>
      <div class="flex items-center justify-between gap-4 py-3">
        <dt class="font-light text-base-content/60">Email</dt>
        <dd class="break-all"><%= @user.email %></dd>
      </div>
      <div class="flex items-center justify-between gap-4 py-3">
        <dt class="font-light text-base-content/60">Rolle</dt>
        <dd><%= @user.role_name %></dd>
      </div>
      <div class="flex items-center justify-between gap-4 py-3">
        <dt class="font-light text-base-content/60">Geschäft</dt>
        <dd>
          <% if @user.business.present? %>
            <%= link_to admin_store_path(@user.business),
            class: "link-more inline-flex items-center gap-1 text-sm md:text-base" do %>
              <%= @user.business.business_name %>
              <%= heroicon "arrow-top-right-on-square", options: { class: "w-4 h-4 shrink-0" } %>
            <% end %>
          <% else %>
            -
          <% end %>
        </dd>
      </div>
      <div class="flex items-center justify-between gap-4 py-3">
        <dt class="font-light text-base-content/60">Registriert am</dt>
        <dd><%= l @user.created_at, format: :short %></dd>
      </div>
    </dl>
  </div>

  <% if current_user.superadmin? %>
    <div class="mt-8 border-t border-base-200 pt-6">
      <p class="admin-eyebrow mb-3">Rolle ändern</p>
      <%= form_with model: @user,
      url: admin_user_path(@user),
      method: :patch,
      local: true,
      class: "flex flex-wrap items-center gap-2" do |f| %>
        <%= f.select :role,
        [ [ "Benutzer", 0 ], [ "Admin", 1 ], [ "Superadmin", 2 ] ],
        { selected: @user.role },
        class: "select select-bordered rounded-full w-48" %>
        <%= f.submit "Aktualisieren", class: "btn btn-primary rounded-full" %>
      <% end %>
      <p class="admin-subtitle mt-2 text-xs">
        Nur Superadmins können die Rolle eines Benutzers ändern.
      </p>
    </div>
  <% end %>

  <% unless @user.deleted? || @user == current_user %>
    <div class="mt-8 border-t border-error/20 pt-6">
      <p class="admin-eyebrow mb-3 text-error/70">Gefahrenzone</p>
      <p class="admin-subtitle mb-4">
        Der Benutzer wird deaktiviert und kann sich nicht mehr anmelden.
      </p>
      <%= link_to admin_user_path(@user),
      class: "btn btn-error btn-outline rounded-full gap-2",
      data: {
        turbo_confirm: "Soll der Benutzer wirklich gelöscht werden?",
        turbo_method: :delete,
      } do %>
        <%= heroicon "trash", options: { class: "w-4 h-4" } %>
        Benutzer löschen
      <% end %>
    </div>
  <% end %>
</div>
