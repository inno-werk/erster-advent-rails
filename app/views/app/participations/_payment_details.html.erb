<% if (upgrade = @participation.pending_upgrade) %>
  <div class="admin-card p-6 mt-6"><%= render "shared/participation_upgrade", upgrade: upgrade %></div>
<% end %>
<p class="mt-6 text-xl font-bold">Jetzt zu bezahlen: <%= participation_amount(@participation.amount_due_cents) %></p>
<% if EventConfiguration.dummy_payments_enabled? %>
  <section class="mt-6 border-t border-base-content/10 pt-6">
    <h2 class="text-xl font-bold">Testzahlung</h2>
    <p class="mt-2 mb-4 text-sm text-base-content/65">Der Testmodus ist aktiviert. Simulieren Sie eine Zahlung ohne Geldfluss.</p>
    <%= link_to "Testzahlung öffnen", app_test_payment_path, class: "btn btn-primary" %>
  </section>
<% elsif @participation.payment_due? %>
  <div class="alert alert-info mt-6">
    <p>Die Online-Zahlung ist noch nicht verfügbar. Es wurde keine Zahlung ausgeführt. Der offene Betrag muss durch die Administration als eingegangen bestätigt werden. Bei Fragen zur Zahlung kontaktieren Sie bitte das Team.</p>
  </div>
<% end %>
