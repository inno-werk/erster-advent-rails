<% content_for :title, "Bezahlung" %>
<% content_for :topbar do %>
  <%= render "app/shared/topbar", crumbs: [ [ "Mitgliedschaft", app_participation_path ], [ "Bezahlung" ] ] %>
<% end %>
<header class="mb-8">
  <p class="admin-eyebrow mb-3">Ihre Mitgliedschaft <%= @participation.year %></p>
  <h1 class="admin-heading">Bezahlung</h1>
  <% if (upgrade = @participation.pending_upgrade) %>
    <p class="admin-subtitle mt-3">Sie haben die Erhöhung auf die Mitgliedschaft «<%= upgrade.category_title %>» für den Ersten Advent Bern <%= @participation.year %> gewählt. Bezahlen Sie jetzt die Differenz von <strong><%= participation_amount(@participation.amount_due_cents) %></strong>. Ihr bereits bezahlter Beitrag wird angerechnet.</p>
    <p class="mt-4 text-base-content/70">Die neue Mitgliedschaft wird aktiviert, sobald der Zahlungseingang bestätigt wurde. Bis dahin bleibt Ihre bisherige Mitgliedschaft bestehen.</p>
  <% else %>
    <p class="admin-subtitle mt-3">Sie haben die Mitgliedschaft «<%= @participation.category_title %>» gewählt. Um Ihre Teilnahme am Ersten Advent Bern <%= @participation.year %> abzuschliessen, bezahlen Sie jetzt <strong><%= participation_amount(@participation.amount_due_cents) %></strong>.</p>
    <p class="mt-4 text-base-content/70">Ihre Teilnahme ist abgeschlossen, sobald der Zahlungseingang bestätigt wurde.</p>
  <% end %>
</header>
<div class="admin-card p-6"><%= render "shared/participation_details", participation: @participation %></div>
<%= render "payment_details" %>
<% content_for :bottombar do %>
  <%= render "app/shared/bottombar", actions: capture {
    concat link_to("Zurück zur Mitgliedschaft", app_participation_path, class: "btn btn-primary")
  } %>
<% end %>
