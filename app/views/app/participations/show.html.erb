<% content_for :title, "Mitgliedschaft" %>
<header class="mb-8">
  <p class="admin-eyebrow mb-3">Ihre Mitgliedschaft</p>
  <h1 class="admin-heading">Mitgliedschaft</h1>
  <p class="admin-subtitle mt-3">Ihr aktueller Status für den Ersten Advent <%= EventConfiguration.year %>.</p>
</header>
<% if @participation %>
  <section class="admin-card p-6 md:p-8">
    <%= render "shared/participation_details", participation: @participation %>
    <% if @participation.pending? %>
      <div class="border-t border-base-300 mt-6 pt-6">
        <p class="mb-4">Ihre Mitgliedschaft ist ausgewählt, die Zahlung ist noch offen. Die Teilnahme ist deshalb noch nicht abgeschlossen.</p>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Zur Zahlung", payment_app_participation_path, class: "btn btn-primary" %>
          <%= link_to "Mitgliedschaft ändern", edit_app_participation_path(setup: 0), class: "btn btn-outline" %>
        </div>
      </div>
    <% end %>
    <% if (upgrade = @participation.pending_upgrade) %>
      <div class="border-t border-base-300 mt-6 pt-6">
        <%= render "shared/participation_upgrade", upgrade: upgrade %>
        <%= link_to "Differenz bezahlen", payment_app_participation_path, class: "btn btn-primary mt-5" %>
      </div>
    <% elsif @participation.upgrade_available? %>
      <div class="border-t border-base-300 mt-6 pt-6">
        <p class="mb-4">Sie können Ihre bezahlte Mitgliedschaft erhöhen. Bereits geleistete Beiträge werden angerechnet.</p>
        <%= link_to "Mitgliedschaft erhöhen", edit_app_participation_path(setup: 0), class: "btn btn-outline" %>
      </div>
    <% end %>
  </section>
<% else %>
  <section class="admin-card p-6 md:p-8 max-w-3xl">
    <span class="badge badge-warning mb-4">Noch keine Mitgliedschaft</span>
    <h2 class="text-2xl font-bold mb-3">Machen Sie mit am Ersten Advent.</h2>
    <p class="text-base-content/70 mb-6">Für <%= EventConfiguration.year %> haben Sie noch keine Mitgliedschaft ausgewählt. Starten Sie die Anmeldung und wählen Sie den passenden Teilnahmebeitrag für Ihr Geschäft.</p>
    <%= link_to "Mitgliedschaft auswählen", edit_app_participation_path, class: "btn btn-primary" %>
  </section>
<% end %>
