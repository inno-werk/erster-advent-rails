<% items = print_order.items.reject(&:marked_for_destruction?) %>
<section aria-labelledby="print-order-summary-heading">
  <header class="flex flex-col gap-3 border-b border-base-content/10 pb-5 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
    <div>
      <h2 id="print-order-summary-heading" class="text-base font-semibold">Ausgewählte Materialien</h2>
      <% if items.any? %>
        <p class="mt-1 text-sm text-base-content/60"><%= items.size %> <%= items.size == 1 ? 'Materialart' : 'Materialarten' %> · <%= items.sum(&:quantity) %> Bündel insgesamt</p>
      <% end %>
    </div>
    <% if items.any? %>
      <p class="text-xs leading-relaxed text-base-content/60 sm:text-right">Zuletzt aktualisiert am <time class="block" datetime="<%= print_order.updated_at.iso8601 %>"><%= l(print_order.updated_at.in_time_zone("Europe/Zurich"), format: "%d.%m.%Y, %H:%M") %></time></p>
    <% end %>
  </header>
  <% if items.any? %>
    <ul class="divide-y divide-base-content/10 border-b border-base-content/10">
      <% items.each do |item| %>
        <% product = item.print_product %>
        <li class="grid grid-cols-[4rem_minmax(0,1fr)] items-start gap-x-4 gap-y-2 py-6 sm:grid-cols-[5rem_minmax(0,1fr)_auto] sm:gap-x-6">
          <div class="row-span-2 flex h-16 w-16 items-center justify-center sm:row-span-1 sm:h-20 sm:w-20">
            <% if product.image.attached? %>
              <%= image_tag product.image, alt: product.title, class: "h-full w-full object-contain" %>
            <% else %>
              <%= heroicon "document-text", variant: :outline, options: { class: "h-8 w-8 text-base-content/35", "aria-hidden": true } %>
            <% end %>
          </div>
          <div class="min-w-0">
            <h3 class="font-semibold leading-relaxed"><%= product.title %></h3>
            <div class="mt-1 text-sm leading-relaxed text-base-content/65"><%= simple_format product.description %></div>
            <% unless product.active? %><p class="mt-2 text-xs text-base-content/60">Nicht mehr im Sortiment. Ihre Bestellung bleibt bestehen.</p><% end %>
          </div>
          <p class="col-start-2 text-sm font-semibold tabular-nums sm:col-start-3 sm:text-right"><span data-bundle-quantity><%= item.quantity %></span> Bündel</p>
        </li>
      <% end %>
    </ul>
    <p class="mt-4 max-w-2xl text-xs leading-relaxed text-base-content/60">Die Anzahl bezeichnet Bündel. Der Inhalt pro Bündel ist beim jeweiligen Material beschrieben.</p>
  <% else %>
    <p class="border-b border-base-content/10 py-8 text-sm text-base-content/65">Sie haben noch kein Printmaterial bestellt.</p>
  <% end %>
</section>
