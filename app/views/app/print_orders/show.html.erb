<% content_for :title, "Meine Printbestellung" %>
<% distribution = PrintDistribution.current %>
<% content_for :topbar do %>
  <%= render "app/shared/topbar", crumbs: [ [ "Dashboard", app_root_path ], [ "Meine Printbestellung" ] ] %>
<% end %>
<div class="max-w-5xl">
  <header class="mb-10">
    <h1 class="admin-heading">Meine Printbestellung <%= EventConfiguration.year %></h1>
    <p class="admin-subtitle mt-3">Hier sehen Sie Ihre ausgewählten Printmaterialien.</p>
    <%= render "app/print_orders/deadline", distribution: distribution %>
  </header>
  <%= render "app/print_orders/summary", print_order: @print_order %>
  <% if distribution.orders_open? %>
    <div class="mt-6">
      <%= link_to "Bestellung bearbeiten", edit_app_print_order_path, class: "btn btn-primary" %>
    </div>
  <% end %>
  <%= render "shared/print_delivery" %>
</div>
