<% content_for :title, "Testzahlung" %>
<header class="mb-8">
  <p class="admin-eyebrow mb-3">Nur für Entwicklung und Tests</p>
  <h1 class="admin-heading">Testzahlung bestätigen</h1>
  <p class="admin-subtitle mt-3">Hier können Sie eine erfolgreiche Zahlung von Hand simulieren.</p>
</header>
<section class="admin-card p-6 md:p-8">
  <h2 class="text-xl font-bold"><%= @upgrade ? "Differenz für «#{@upgrade.category_title}»" : "Mitgliedschaft «#{@participation.category_title}»" %></h2>
  <p class="mt-2 text-sm text-base-content/65">Veranstaltungsjahr <%= @participation.year %></p>
  <p class="my-6 text-4xl font-bold"><%= participation_amount(@amount_cents) %></p>
  <p class="text-base-content/75">Es wird kein Geld abgebucht. Mit der Bestätigung wird die <%= @upgrade ? 'Erhöhung' : 'Mitgliedschaft' %> sofort als bezahlt markiert und aktiviert. Der Datensatz bleibt als Testzahlung gekennzeichnet.</p>
  <%= form_with url: app_test_payment_path, id: "test-payment-form", method: :post do %>
    <%= hidden_field_tag :token, @token %>
  <% end %>
</section>
<% content_for :bottombar do %>
  <%= render "app/shared/bottombar", hint: "Simulation · kein echter Geldfluss", actions: capture {
    concat link_to("Abbrechen", payment_app_participation_path(setup: @continue_setup ? 1 : nil), class: "btn btn-ghost")
    concat button_tag("Ja, als bezahlt markieren", type: "submit", form: "test-payment-form", class: "btn btn-primary")
  } %>
<% end %>
