<% content_for :heading, "Ihr Konto wieder freischalten" %>
<% content_for :preheader, "Entsperren Sie Ihr Konto nach mehreren fehlgeschlagenen Anmeldeversuchen." %>
<p style="margin:0 0 16px;">Guten Tag <%= @resource.name.presence || @resource.email %></p>
<p style="margin:0 0 16px;">Ihr Konto wurde nach mehreren fehlgeschlagenen Anmeldeversuchen vorübergehend gesperrt. Sie können es über den folgenden Link entsperren.</p>
<%= render "mailers/button", label: "Konto entsperren", url: user_unlock_url(unlock_token: @token, locale: nil) %>
