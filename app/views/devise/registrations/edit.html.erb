<% content_for :title, "Kontoeinstellungen" %>
<% content_for :topbar do %>
  <%= render "app/shared/topbar", crumbs: [ [ "Dashboard", app_root_path ], [ "Kontoeinstellungen" ] ] %>
<% end %>

<div class="max-w-5xl">
  <header class="border-b border-base-content/10 pb-6">
    <p class="font-jakarta text-xs uppercase tracking-[0.35em] text-primary/80">Übersicht</p>
    <h1 class="admin-heading mt-2">Kontoeinstellungen</h1>
    <p class="admin-subtitle mt-2 max-w-3xl">So sind Ihre Kontoangaben hinterlegt. Bearbeiten Sie persönliche Angaben und Passwort getrennt.</p>
  </header>

  <div class="mt-10">
    <section class="form-section" aria-labelledby="personal-details-heading">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 id="personal-details-heading" class="form-section-title">Persönliche Angaben</h2>
          <p class="form-section-subtitle">Diese Angaben verwendet das Team, um Sie zu erreichen.</p>
        </div>
        <%= link_to edit_personal_user_registration_path, class: "btn btn-outline btn-sm gap-2" do %>
          <%= heroicon "pencil-square", options: { class: "h-4 w-4", "aria-hidden": true } %>
          Angaben bearbeiten
        <% end %>
      </div>

      <div class="data-grid">
        <%= render "app/shared/data_item", label: "Vor- und Nachname", value: resource.name %>
        <%= render "app/shared/data_item", label: "Telefonnummer", value: resource.phone %>
        <div class="md:col-span-2">
          <%= render "app/shared/data_item", label: "E-Mail-Adresse", value: resource.email %>
        </div>
      </div>
      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="mt-4 text-sm text-base-content/70">Die Bestätigung für <strong><%= resource.unconfirmed_email %></strong> steht noch aus.</p>
      <% end %>
    </section>

    <section class="form-section" aria-labelledby="password-details-heading">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 id="password-details-heading" class="form-section-title">Passwort</h2>
          <p class="form-section-subtitle">Ihr Passwort wird aus Sicherheitsgründen nicht angezeigt.</p>
        </div>
        <%= link_to edit_password_user_registration_path, class: "btn btn-outline btn-sm gap-2" do %>
          <%= heroicon "key", options: { class: "h-4 w-4", "aria-hidden": true } %>
          Passwort ändern
        <% end %>
      </div>
    </section>

    <section class="mt-12 border-t border-warning/50 pt-8" aria-labelledby="deactivate-account-heading">
      <div class="flex max-w-3xl items-start gap-3 text-warning">
        <%= heroicon "exclamation-triangle", options: { class: "mt-0.5 h-6 w-6 shrink-0", "aria-hidden": true } %>
        <div>
          <h2 id="deactivate-account-heading" class="form-section-title text-base-content">Konto löschen</h2>
          <p class="mt-2 text-sm leading-relaxed text-base-content/65">Nach der Deaktivierung können Sie sich nicht mehr anmelden und Ihr Geschäft wird nicht mehr öffentlich angezeigt. Ihre Konto-, Teilnahme-, Zahlungs- und Bestelldaten bleiben erhalten.</p>
          <%= button_to "Konto löschen", registration_path(resource_name),
            data: { turbo_confirm: "Möchten Sie Ihr Konto wirklich deaktivieren? Sie können sich danach nicht mehr anmelden. Ihre Daten bleiben erhalten." },
            method: :delete, class: "btn btn-error btn-outline mt-5" %>
        </div>
      </div>
    </section>
  </div>
</div>
