<% content_for :title, "Passwort ändern" %>
<% content_for :topbar do %>
  <%= render "app/shared/topbar", crumbs: [ [ "Dashboard", app_root_path ], [ "Kontoeinstellungen", edit_user_registration_path ], [ "Passwort ändern" ] ] %>
<% end %>

<div class="max-w-5xl">
  <header class="mb-10">
    <h1 class="admin-heading">Passwort ändern</h1>
    <p class="admin-subtitle mt-3">Bestätigen Sie die Änderung mit Ihrem bisherigen Passwort.</p>
  </header>

  <%= form_for(resource, as: resource_name, url: password_user_registration_path, html: { method: :patch, id: "password-settings-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <section class="form-section">
      <div class="grid gap-6 md:grid-cols-3 md:gap-10">
        <div>
          <h2 class="form-section-title">Neues Passwort</h2>
          <p class="form-section-subtitle">Verwenden Sie ein Passwort, das Sie nicht für andere Konten einsetzen.</p>
        </div>
        <div class="grid gap-5 md:col-span-2 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <%= f.label :current_password, "Bisheriges Passwort", class: "field-label" %>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "field-input", required: true %>
          </div>
          <div>
            <%= f.label :password, "Neues Passwort", class: "field-label" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "field-input", required: true %>
            <% if @minimum_password_length %><p class="field-hint">Mindestens <%= @minimum_password_length %> Zeichen.</p><% end %>
          </div>
          <div>
            <%= f.label :password_confirmation, "Neues Passwort bestätigen", class: "field-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input", required: true %>
          </div>
        </div>
      </div>
    </section>
  <% end %>
</div>

<% content_for :bottombar do %>
  <%= render "app/shared/bottombar", actions: capture {
    concat link_to("Abbrechen", edit_user_registration_path, class: "btn btn-ghost")
    concat button_tag("Passwort speichern", type: "submit", form: "password-settings-form", class: "btn btn-primary")
  } %>
<% end %>
