<section class="min-h-screen bg-gradient-to-r bg-primary">
  <div class="hero min-h-screen bg-transparent">
    <div class="hero-content w-full max-w-4xl flex-col">
      <div
        class="
          card relative w-full overflow-visible bg-base-100 shadow-2xl rounded-3xl
        "
      >
        <div
          class="
            absolute -top-10 left-1/2 flex h-20 w-20 -translate-x-1/2 items-center
            justify-center rounded-full border-4 border-base-100 bg-secondary
            text-primary-content shadow-xl
          "
        >
          <%= heroicon "user-plus", options: { class: "h-10 w-10" } %>
        </div>

        <div class="card-body px-6 py-10 lg:px-12">
          <div class="mt-6 space-y-2 text-center">
            <h2 class="text-3xl font-bold text-base-content">
              Registrieren, um ein Konto zu erstellen
            </h2>

            <p class="text-base text-base-content/80">
              Haben Sie bereits ein Konto?
              <%= link_to "Anmelden",
              new_session_path(resource_name),
              class: "font-semibold text-secondary hover:underline" %>
            </p>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: {
            id: "registration-form", class: "mt-6", data: {
              controller: "auth-form", auth_form_invalid: resource.errors.any?,
              action: "turbo:submit-start->auth-form#rememberPassword turbo:before-render@document->auth-form#restorePassword turbo:before-cache@document->auth-form#scrubInputs pagehide@window->auth-form#leavePage"
            }
          }) do |f| %>
            <div class="space-y-6">
              <% if resource.errors.any? %>
                <p class="text-sm text-base-content/70">Bitte prüfen Sie die markierten Felder.</p>
                <% resource.errors.full_messages_for(:base).each do |message| %>
                  <p class="text-sm text-error" role="alert"><%= message %></p>
                <% end %>
              <% end %>

              <div class="grid gap-4 md:grid-cols-2">
                <% [
                  [:business_name, :text, "Firmenname", "Geben Sie Ihren Firmennamen ein", "organization"],
                  [:email, :email, "E-Mail-Adresse", "Geben Sie Ihre gültige E-Mail ein", "email"],
                  [:address, :text, "Adresse", "Geben Sie Ihre Postadresse ein", "street-address"],
                  [:name, :text, "Vor- und Nachname", "Geben Sie Ihren Vor- und Nachnamen ein", "name"],
                  [:password, :password, "Passwort", "Geben Sie Ihr Passwort ein", "new-password"],
                  [:phone, :telephone, "Telefonnummer", "Geben Sie Ihre Telefonnummer ein", "tel"]
                ].each do |field, type, label, placeholder, autocomplete| %>
                  <% errors = auth_field_errors(resource, field) %>
                  <% password = field == :password %>
                  <% hint = password && @minimum_password_length ? "user_password_hint" : nil %>
                  <% options = auth_input_options(field, errors: errors, extra_class: ("pr-12" if password), hint: hint).merge(
                    placeholder: placeholder, autocomplete: autocomplete, required: true,
                    autofocus: resource.errors.empty? && field == :business_name
                  ) %>
                  <div class="form-control">
                    <%= f.label field, class: "label" do %>
                      <span class="label-text font-semibold"><%= label %></span>
                    <% end %>
                    <% if password %>
                      <div class="relative" data-controller="password-visibility">
                        <%= f.password_field field, **options, data: { password_visibility_target: "input", auth_password: true } %>
                        <button type="button" class="btn btn-ghost btn-xs absolute right-2 top-1/2 -translate-y-1/2" data-action="password-visibility#toggle">
                          <%= heroicon "eye", options: { class: "h-5 w-5" } %>
                          <span class="sr-only" data-password-visibility-target="label">Passwort anzeigen</span>
                        </button>
                      </div>
                      <% if @minimum_password_length %>
                        <p id="user_password_hint" class="mt-1 text-sm text-base-content/60">Mindestens <%= @minimum_password_length %> Zeichen</p>
                      <% end %>
                    <% else %>
                      <%= f.public_send("#{type}_field", field, **options) %>
                    <% end %>
                    <%= render "devise/shared/field_errors", field: field, errors: errors %>
                  </div>
                <% end %>
              </div>

              <div class="flex justify-center">
                <%= f.submit "Registrieren", class: "btn btn-primary px-10" %>
              </div>
            </div>
          <% end %>
          <div class="mt-6">
            <%= render "devise/shared/links" %>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
