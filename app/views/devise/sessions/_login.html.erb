<% credential_error = login_credentials_invalid? %>
<% email_errors = auth_field_errors(resource, :email) %>
<% password_errors = auth_field_errors(resource, :password) %>
<% if credential_error %>
  <% email_errors << "Bitte prüfen Sie Ihre E-Mail-Adresse." %>
  <% password_errors << flash[:alert] if flash[:alert].present? %>
<% end %>
<section
  class="min-h-screen bg-gradient-to-br from-primary via-primary to-primary"
>
  <div
    class="
      flex min-h-screen items-center justify-center px-4 py-10 sm:px-6 lg:px-8
    "
  >
    <div
      class="
        relative w-full max-w-xl rounded-3xl bg-base-100 px-8 py-12 shadow-2xl
      "
    >
      <div
        class="
          absolute -top-10 left-1/2 flex h-20 w-20 -translate-x-1/2 items-center
          justify-center rounded-full border-4 border-base-100 bg-secondary
          text-primary-content shadow-xl
        "
      >
        <%= heroicon "lock-closed", options: { class: "h-10 w-10" } %>
      </div>

      <div class="space-y-3 text-center">
        <h1 class="text-3xl font-bold text-base-content">
          <%= admin_login ? "Admin-Login" : "Melden Sie sich bei Ihrem Konto an" %>
        </h1>
        <% if admin_login %>
          <p class="text-base text-base-content/80">Melden Sie sich mit Ihrem Administrationskonto an.</p>
        <% end %>
      </div>

      <div class="mt-6">
        <% if flash[:alert].present? && !credential_error %>
          <p class="rounded-xl border border-error/30 bg-error/10 px-4 py-3 text-sm text-error" role="alert" data-turbo-cache="false"><%= flash[:alert] %></p>
        <% end %>
        <% resource.errors.full_messages_for(:base).each do |message| %>
          <p class="text-sm text-error" role="alert"><%= message %></p>
        <% end %>
      </div>

      <%= form_for(resource, as: resource_name, url: login_path, html: {
        id: admin_login ? "admin-login-form" : "login-form", data: {
          controller: "auth-form", auth_form_invalid: flash[:alert].present? || resource.errors.any?,
          action: "turbo:submit-start->auth-form#rememberPassword turbo:before-render@document->auth-form#restorePassword turbo:before-cache@document->auth-form#scrubInputs pagehide@window->auth-form#leavePage"
        }
      }) do |f| %>
        <div class="mt-8 space-y-6">
          <div class="form-control">
            <%= f.label :email, class: "label" do %>
              <span class="label-text font-semibold">E-Mail-Adresse</span>
            <% end %>
            <%= f.email_field :email,
                          **auth_input_options(:email, errors: email_errors),
                          autofocus: email_errors.empty? && password_errors.empty?,
                          autocomplete: "email",
                          required: true,
                          placeholder: "Geben Sie Ihre gültige E-Mail ein" %>
            <%= render "devise/shared/field_errors", field: :email, errors: email_errors %>
          </div>

          <div class="form-control">
            <%= f.label :password, class: "label" do %>
              <span class="label-text font-semibold">Passwort</span>
            <% end %>
            <div class="relative" data-controller="password-visibility">
              <%= f.password_field :password,
                               **auth_input_options(:password, errors: password_errors, extra_class: "pr-12"),
                               autocomplete: "current-password",
                               required: true,
                               placeholder: "Geben Sie Ihr Passwort ein",
                               data: {
                                 password_visibility_target: "input",
                                 auth_password: true,
                               } %>
              <button
                type="button"
                class="
                  btn btn-ghost btn-xs absolute right-2 top-1/2 -translate-y-1/2
                "
                data-action="password-visibility#toggle"
              >
                <%= heroicon "eye", options: { class: "h-5 w-5 password-visibility--show" } %>
                <span class="sr-only" data-password-visibility-target="label">Passwort anzeigen</span>
              </button>
            </div>
            <%= render "devise/shared/field_errors", field: :password, errors: password_errors %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="form-control">
              <label class="label cursor-pointer justify-start gap-3">
                <%= f.check_box :remember_me, class: "checkbox checkbox-primary" %>
                <span class="label-text text-base-content">Angemeldet bleiben</span>
              </label>
            </div>
          <% end %>

          <div class="pt-2">
            <%= f.submit "Anmelden", class: "btn btn-primary w-full" %>
          </div>
        </div>
      <% end %>

      <div class="mt-6">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</section>
