<%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
<%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

<%= favicon_link_tag "logo.svg", type: "image/svg+xml" %>

<link rel="icon" href="<%= asset_path("logo.svg") %>" type="image/svg+xml">
<%# Safari/iOS does not support SVG apple-touch-icons, keep the PNG here %>
<link rel="apple-touch-icon" href="<%=asset_path("logo.png") %>">

<%# Includes all stylesheet files in app/assets/stylesheets %>
<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "application",
media: "all",
"data-turbolinks-track": "reload" %>
<%= javascript_importmap_tags %>

<%# Must come after the stylesheets so it overrides the compiled theme. %>
<%= brand_color_style_tag %>
