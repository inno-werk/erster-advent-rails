<!DOCTYPE html>
<html data-theme="light" lang="de">
  <head>
    <title><%= content_for(:title) || "Erster Advent Bern" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "layouts/head" %>
  </head>

  <body class="admin-shell" data-layout="admin">

    <div class="flex h-full flex-col">

      <div class="drawer relative min-h-0 flex-1 overflow-hidden lg:drawer-open">
        <input id="my-drawer" type="checkbox" class="drawer-toggle"/>
        <div class="drawer-content flex h-full min-h-0 min-w-0 flex-col overflow-hidden bg-base-100" data-controller="unsaved-changes">

            <!-- Mobile top bar with drawer toggle -->
            <div
              class="
                shrink-0 z-10 flex items-center gap-3 bg-primary px-4 py-3
                text-primary-content lg:hidden
              "
            >
              <label
                for="my-drawer"
                aria-label="Menü öffnen"
                class="btn btn-ghost btn-square btn-sm text-primary-content"
              >
                <%= heroicon "bars-3", variant: :outline, options: { class: "w-6 h-6" } %>
              </label>
              <%= image_tag "logo.svg", alt: "Erster Advent Logo", class: "h-7 w-auto" %>
              <span class="font-jakarta font-bold"><%= content_for(:title) || "Admin" %></span>
            </div>

          <% if content_for?(:admin_list_header) %>
            <%= yield :admin_list_header %>
            <main class="admin-list-scroll" tabindex="0" aria-label="Liste">
              <%= yield %>
            </main>
            <%= yield :admin_list_footer %>
          <% elsif content_for?(:admin_detail_header) %>
            <%= yield :admin_detail_header %>
            <main class="admin-detail-scroll" tabindex="0" aria-label="Detailübersicht">
              <%= yield %>
            </main>
          <% elsif content_for?(:topbar) %>
            <%= yield :topbar %>
            <main class="min-h-0 flex-1 overflow-y-auto">
              <div class="app-container py-8"><%= yield %></div>
            </main>
            <%= yield :bottombar %>
          <% else %>
            <main class="min-h-0 flex-1 overflow-y-auto bg-base-200 px-4 py-6 sm:px-6">
              <%= yield %>
            </main>
          <% end %>
        </div>
        <div class="drawer-side z-20">
          <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
          <aside
            class="
              h-full w-72 max-w-full brand-gradient
              text-primary-content
            "
          >
            <div class="flex h-full flex-col gap-6 px-4 py-6">
              <a href="<%= root_path %>" class="flex items-center gap-3 px-2">
                <span
                  class="
                    flex h-12 w-12 shrink-0 items-center justify-center rounded-full
                    bg-secondary text-secondary-content
                  "
                >
                  <%= image_tag "logo.svg", alt: "Erster Advent Logo", class: "h-8 w-auto" %>
                </span>
                <span>
                  <span class="block font-jakarta font-bold text-sm leading-tight">
                    1. Advent Untere Altstadt
                  </span>
                  <span class="block font-jakarta font-light text-xs opacity-70">
                    Admin Dashboard
                  </span>
                </span>
              </a>

              <ul class="flex-1 space-y-1.5 overflow-y-auto">
                <%= render "layouts/menu_item",
                link: admin_root_path,
                text: "Dashboard",
                icon: "squares-2x2" %>
                <%= render "layouts/menu_item",
                link: admin_stores_path,
                text: "Geschäfte",
                icon: "building-storefront",
                active: controller.controller_name == "stores" %>
                <%= render "layouts/menu_item",
                link: admin_users_path,
                text: "Benutzer",
                icon: "users",
                active: controller.controller_name == "users" %>
                <%= render "layouts/menu_item", link: admin_participations_path, text: "Teilnahmen / Zahlungen", icon: "credit-card" %>
                <%= render "layouts/menu_item", link: admin_print_products_path, text: "Printprodukte", icon: "photo" %>
                <%= render "layouts/menu_item", link: admin_print_orders_path, text: "Printbestellungen", icon: "document-text", active: %w[print_orders print_order_exports].include?(controller.controller_name) %>
                <%= render "layouts/menu_item",
                link: edit_admin_cms_path,
                text: "Frontpage CMS",
                icon: "pencil-square" %>
              </ul>

              <div class="space-y-3 border-t border-white/20 pt-4">
                <div class="flex items-center gap-3 px-2">
                  <span
                    class="
                      flex h-9 w-9 shrink-0 items-center justify-center rounded-full
                      border border-white/30
                    "
                  >
                    <%= heroicon "user", variant: :outline, options: { class: "w-5 h-5" } %>
                  </span>
                  <p class="truncate font-jakarta font-semibold text-sm">
                    <%= current_user.business_name.presence || current_user.email %>
                  </p>
                </div>
                <%= link_to marketing_stores_path,
                class: "admin-menu-item text-sm" do %>
                  <%= heroicon "arrow-top-right-on-square",
                  variant: :outline,
                  options: {
                    class: "w-5 h-5 shrink-0",
                  } %>
                  Zur Website
                <% end %>
                <%= button_to destroy_user_session_path,
                method: :delete,
                form_class: "w-full",
                class: "admin-menu-item text-sm cursor-pointer" do %>
                  <%= heroicon "arrow-right-on-rectangle",
                  variant: :outline,
                  options: {
                    class: "w-5 h-5 shrink-0",
                  } %>
                  Logout
                <% end %>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </body>
</html>
