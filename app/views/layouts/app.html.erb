<!DOCTYPE html>
<html data-theme="light" lang="de">
  <head>
    <title><%= content_for(:title) || "Erster Advent Bern" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "layouts/head" %>
  </head>

  <%# The dashboard owns the viewport: the window itself never scrolls, only the
    page body between the app shell's bars does. %>
  <body class="h-screen overflow-hidden">


    <div class="flex h-full min-h-0 flex-col">

      <div class="drawer relative min-h-0 flex-1 overflow-hidden lg:drawer-open">
        <input id="my-drawer" type="checkbox" class="drawer-toggle"/>
        <%# App shell: the optional top bar (breadcrumb + actions) and bottom bar
          (primary action) stay put while only the page body scrolls between
          them. Pages fill the slots with content_for :topbar / :bottombar. %>
        <div
          class="drawer-content flex h-full min-h-0 flex-col overflow-hidden"
          data-controller="unsaved-changes"
        >
          <div class="flex items-center gap-3 bg-primary px-4 py-3 text-primary-content lg:hidden">
            <label for="my-drawer" aria-label="Menü öffnen" class="btn btn-ghost btn-square btn-sm">
              <%= heroicon "bars-3", options: { class: "h-6 w-6" } %>
            </label>
            <span class="font-bold">Mein Geschäft</span>
          </div>
          <%= yield :topbar %>
          <div class="min-h-0 flex-1 overflow-y-auto">
            <div class="app-container py-8">
              <%= yield %>
            </div>
          </div>
          <%= yield :bottombar %>
        </div>
        <div class="drawer-side">
          <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
          <aside
            class="
              h-full w-72 max-w-full border-r border-base-300 bg-primary text-primary-content
              backdrop-blur-lg
            "
          >
            <div class="flex h-full flex-col gap-4 px-4 py-6">
              <header class="flex flex-col items-start gap-4" data-sidebar-brand>
                <a
                  href="<%= root_path %>"
                  class="inline-flex shrink-0"
                >
                  <%= image_tag "logo.svg", alt: "Erster Advent Logo", class: "h-8 w-auto" %>
                </a>
                <div class="min-w-0 w-full">
                  <p class="text-sm font-semibold [overflow-wrap:anywhere]"><%= current_user.business_name&.presence || current_user.email %></p>
                  <p class="mt-1 text-xs">Dashboard</p>
                </div>
              </header>
              <ul class="menu flex-1 gap-1 w-full">
                <%= render "layouts/menu_item", link: app_participation_path, text: "Mitgliedschaft", active: %w[participations test_payments].include?(controller_name),
                  attention: current_user.current_participation&.paid? && !current_user.current_participation.payment_due? ? nil : "Teilnahme oder Zahlung noch offen" %>
                <%= render "layouts/menu_item", link: app_print_order_path, text: "Meine Printbestellung", active: controller_name == "print_orders" %>
                <%= render "layouts/menu_item", link: app_mystore_path, text: "Mein Geschäft", active: controller_name == "mystore",
                  attention: !current_user.business_editing_allowed? || current_user.business&.confirmed? ? nil : "Geschäft noch nicht freigegeben" %>
                <%= render "layouts/menu_item", link: edit_user_registration_path, text: "Kontoeinstellungen", active: controller_path == "users/registrations" %>
              </ul>
              <div class="space-y-3">
                <%= button_to "Logout",
                destroy_user_session_path,
                method: :delete,
                class: "btn btn-outline w-full" %>
                <% if current_user.adminish? %>
                  <%= link_to "Admin", admin_users_path, class: "link link-primary" %>
                <% end %>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </body>
</html>
