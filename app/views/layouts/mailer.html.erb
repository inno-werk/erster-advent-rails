<!DOCTYPE html>
<html lang="de">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for(:heading) || "Erster Advent Bern" %></title>
  </head>
  <body data-mail-layout="branded" style="margin:0;padding:0;background-color:#f2f3f1;color:#25323a;font-family:Arial,Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;"><%= content_for(:preheader) %></div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#f2f3f1">
      <tr><td align="center" style="padding:32px 16px;">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;">
          <tr><td bgcolor="<%= brand_color %>" style="padding:28px 32px;border-radius:12px 12px 0 0;">
            <p style="margin:0 0 6px;color:#ffffff;font-size:11px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;">Gemeinsam für unsere Stadt</p>
            <p style="margin:0;color:#ffffff;font-family:Georgia,serif;font-size:30px;line-height:1.2;">Erster Advent Bern</p>
          </td></tr>
          <tr><td bgcolor="#ffffff" style="padding:32px;border-radius:0 0 12px 12px;font-size:16px;line-height:1.7;">
            <% if content_for?(:heading) %><h1 style="margin:0 0 22px;font-size:25px;line-height:1.3;color:#25323a;"><%= yield :heading %></h1><% end %>
            <%= yield %>
            <p style="margin:28px 0 0;padding-top:24px;border-top:1px solid #e6e9e7;color:#647078;font-size:14px;">Herzliche Grüsse<br><strong style="color:#25323a;">Das Team Erster Advent Bern</strong></p>
          </td></tr>
          <tr><td align="center" style="padding:22px 20px;color:#747b80;font-size:12px;line-height:1.7;">
            Fragen? Wir helfen Ihnen gerne weiter.<br>
            <%= mail_to "info@erster-advent-bern.ch", "info@erster-advent-bern.ch", style: "color:#{brand_color};text-decoration:underline;" %>
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
