<!DOCTYPE html>
<html data-theme="light" lang="de">
  <head>
    <title><%= content_for(:title) || "Erster Advent" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= render "layouts/head" %>

    <style>
    button:has(+ #popover-1:popover-open) .icon-down {
  display: none;
}
button:has(+ #popover-1:popover-open) .icon-up {
  display: inline-block;
}
    </style>

  </head>

  <body class="bg-white group large" data-controller="scroll-nav">

    <%# The minimized bar's background belongs on this full-width wrapper, not
        on the <header>: the header lives inside .page-container, which caps at
        1640px and pads, so a background there would stop short of the screen
        edges. The bar spans the viewport, its content stays in the grid. %>
    <div
      class="
        fixed top-0 left-0 w-full z-10 duration-300 ease-in-out will-change-transform
        transition-[translate,opacity,background-color] translate-y-0 opacity-100
        bg-transparent group-[.small]:bg-primary
        group-[.small.down]:-translate-y-full group-[.small.down]:opacity-0
        group-[.small.up]:translate-y-0 group-[.small.up]:opacity-100
      "
    >
      <div class="page-container">
        <header
          class="
            navbar bg-transparent w-full p-0 items-start duration-300 ease-in-out
            transition-[height,padding]
            group-[.small]:h-[var(--nav-small-height)] group-[.small]:items-center
            group-[.large]:h-[calc(var(--nav-top-offset)_+_var(--nav-logo-height))]
            group-[.large]:pt-[var(--nav-top-offset)]
          "
        >
          <!-- left / brand -->
          <div class="navbar-start h-full">
            <a href="<%= root_path %>" class="flex h-full items-center">
              <%= image_tag "logo.svg",
              alt: "Erster Advent Logo",
              class:
                "h-full w-auto group-[.small]:h-[var(--nav-small-mark-ratio)]" %>
              <div class="nav-lockup hidden sm:block group-[.small]:hidden">
                <p class="text-black">
                  1.&#8201;Advent<br>Untere<br>Altstadt<br>Bern
                </p>
                <p class="text-white">
                  Sonntag<br>29.11.2026<br>11&#8201;&ndash;&#8201;17&nbsp;Uhr
                </p>
              </div>
              <%# 40px between the mark and the date at 1920px (XD: 210.9 -> 251) %>
              <p
                class="
                  hidden group-[.small]:block font-jakarta font-bold text-white
                  text-base md:text-lg lg:text-[28px] whitespace-nowrap
                  ms-[clamp(1rem,2.083vw,2.5rem)]
                "
              >
                Sonntag, 29.11.2026
              </p>
            </a>
          </div>
          <!-- desktop nav -->
          <div class="navbar-end gap-2 flex mx-2">
            <%# The most important control in the bar: it keeps its full size at
                every width and only steps aside below ~480px, where the date it
                sits next to leaves no room at all. Everything else in the bar
                gives way to it. The expanded header carries no date, so it
                always keeps the pill.

                Anywhere in the store section - the index and the detail pages
                alike - it would point at where the visitor already is, so there
                it turns around and offers the way back to the general
                information instead. Matched on the controller rather than the
                path: locale is an optional scope, so /stores and /de/stores are
                the same page, and the search and pagination params must not
                count as a different one either. %>
            <% in_stores_section = controller_path == "marketing/stores" %>
            <%= link_to in_stores_section ? "Allgemeine Infos" : "Geschäfte entdecken",
            in_stores_section ? root_path : marketing_stores_path,
            class: "btn-navbar shrink-0 max-[480px]:group-[.small]:hidden" %>

            <% if current_user %>

              <%# Absorbs whatever width is left after the date and the
                  "Geschäfte entdecken" pill have taken theirs, up to the 354px
                  of the artboard. That way it narrows on its own as the screen
                  gets smaller instead of pushing the pill over the date. It is
                  hidden below md, so it must not claim flex space there. %>
              <div
                class="
                  relative hidden md:flex min-w-[180px] flex-1 max-w-[354px] group/dropdown
                "
                data-controller="dropdown"
                data-action="
                  click@window->dropdown#closeOnOutsideClick
                  keydown.esc@window->dropdown#close
                "
              >
                <button
                  type="button"
                  data-action="dropdown#toggle"
                  <%# Fills its wrapper rather than sizing to its label: with the
                      old min-w the button grew with the business name (a long
                      e-mail made it 334px at md) and shoved the bar's right side
                      over the date. The label truncates instead. %>
                  class="
                    btn-navbar flex w-full cursor-pointer relative
                    z-[2] group-[.open]/dropdown:bg-black group-[.open]/dropdown:border-black
                    group-[.open]/dropdown:text-white
                  "
                >
                  <span class="truncate">
                    <%= current_user.business&.business_name || current_user.email %>
                  </span>
                  <span
                    class="
                      shrink-0 transition-transform duration-200 group-[.open]/dropdown:rotate-180
                    "
                  >
                    <%= heroicon "arrow-down-circle", variant: :outline, options: { class: "w-7 h-7" } %>
                  </span>
                </button>
                <ul
                  data-dropdown-target="menu"
                  class="
                    hidden absolute left-0 top-full z-[1] -mt-7 w-full
                    flex-col gap-2 bg-white rounded-b-[28px] px-6 pt-12 pb-6
                    [&:not(.hidden)]:flex
                  "
                >
                  <% if !current_user.adminish? %>
                    <li><%= link_to "Mein Geschäft", app_mystore_path, class: "menu-item-nav" %></li>
                    <li><%= link_to "Transaktionen", app_transactions_path, class: "menu-item-nav" %></li>
                  <% else %>
                    <li><%= link_to "Admin Dashboard", admin_root_path, class: "menu-item-nav" %></li>
                  <% end %>

                  <li>
                    <%= link_to "Ausloggen",
                    destroy_user_session_path,
                    data: {
                      turbo_method: :delete,
                    },
                    class: "menu-item-nav" %>
                  </li>
                </ul>
              </div>
            <% else %>
              <%= link_to "Anmeldung für Geschäfte",
              new_user_session_path,
              class: "btn-navbar hidden md:flex" %>
            <% end %>
          </div>

        </header>
      </div>
    </div>

    <main class="min-h-screen flex flex-col relative">

      <%= render "layouts/flash", { flash: flash } %>

      <%= yield %>

    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
