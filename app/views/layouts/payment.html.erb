<!DOCTYPE html>
<html data-theme="light" lang="de">
  <head>
    <title><%= content_for(:title) || "Zahlung" %> · Erster Advent Bern</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/head" %>
    <%= yield :head %>
  </head>
  <body class="h-dvh overflow-hidden bg-base-200" data-layout="payment">
    <div class="h-full min-h-0 flex flex-col overflow-hidden">
      <header class="shrink-0 border-b border-base-300 bg-base-100">
        <div class="mx-auto max-w-4xl px-6 py-4 flex flex-wrap items-center justify-between gap-3">
          <%= link_to app_participation_path do %>
            <%= image_tag "logo.svg", alt: "Erster Advent Bern", class: "h-12 w-auto" %>
          <% end %>
          <%= link_to "Zur Mitgliedschaft", app_participation_path, class: "btn btn-ghost btn-sm" %>
        </div>
      </header>
      <main class="min-h-0 flex-1 overflow-y-auto">
        <div class="mx-auto max-w-4xl px-6 py-8 md:py-12">
          <%= yield %>
          <p class="mt-8 text-sm text-base-content/60">Fragen zur Zahlung? <%= mail_to "info@erster-advent-bern.ch", "Kontaktieren Sie uns", class: "link" %></p>
        </div>
      </main>
      <%= yield :bottombar %>
    </div>
  </body>
</html>
