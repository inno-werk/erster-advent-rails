<!DOCTYPE html>
<html data-theme="light" lang="de">
  <head>
    <title><%= content_for(:title) || "Teilnahme einrichten" %> · Erster Advent Bern</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/head" %>
    <%= yield :head %>
  </head>
  <body class="h-dvh overflow-hidden bg-base-200" data-layout="setup">
    <div class="h-full min-h-0 flex flex-col overflow-hidden" data-controller="unsaved-changes">
      <header class="shrink-0 z-20 bg-base-100 border-b border-base-300" data-setup-header>
        <div class="mx-auto max-w-7xl px-6 py-4 flex flex-wrap items-center justify-between gap-3">
          <%= link_to root_path, class: "flex items-center gap-4" do %>
            <%= image_tag "logo.svg", alt: "Erster Advent Bern", class: "h-12 w-auto" %>
            <span class="font-jakarta text-sm text-base-content/60">Teilnahme <%= EventConfiguration.year %></span>
          <% end %>
          <%= link_to "Später fortsetzen · Zum Dashboard", app_participation_path, class: "btn btn-ghost btn-sm" %>
        </div>
      </header>
      <main class="min-h-0 flex-1 overflow-y-auto" data-setup-scroll>
        <div class="mx-auto w-full max-w-7xl px-6 py-8 md:py-10">
          <%= yield %>
        </div>
        <footer class="px-6 py-6 text-center text-sm text-base-content/60">
          Fragen zu Ihrer Teilnahme? <%= mail_to "info@erster-advent-bern.ch", "Kontaktieren Sie uns", class: "link" %>
        </footer>
      </main>
      <%= yield :bottombar %>
    </div>
  </body>
</html>
