<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:28px 0 20px;">
  <tr><td bgcolor="<%= brand_color %>" style="border-radius:8px;">
    <%= link_to label, url, style: "display:inline-block;padding:15px 24px;border:1px solid #{brand_color};border-radius:8px;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;" %>
  </td></tr>
</table>
<p style="margin:0 0 24px;font-size:12px;line-height:1.6;color:#747b80;">Falls die Schaltfläche nicht funktioniert, kopieren Sie diesen Link in Ihren Browser:<br>
  <%= link_to url, url, style: "color:#{brand_color};overflow-wrap:anywhere;word-break:break-all;" %>
</p>
