<div class="store-card col-span-4">
  <div class="store-card-media">
    <%= link_to marketing_store_path(business),
    class: "block h-full w-full",
    aria: {
      label: business.business_name,
    } do %>
      <% if business.main_image.present? %>
        <%= image_tag business.main_image,
        alt: business.business_name,
        class: "object-cover object-center h-full w-full" %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center bg-primary">
          <%= image_tag "logo.svg", alt: "Logo", class: "h-40" %>
        </div>
      <% end %>
    <% end %>
    <% categories = Array(business.categories).compact_blank %>
    <% if categories.any? %>
      <div class="store-card-tags">
        <% categories.each do |tag| %>
          <span class="tag-pill"><%= tag %></span>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="store-card-body">
    <h2 class="store-card-name"><%= business.business_name %></h2>
    <% street = street_address(business.address) %>
    <% if street.present? %>
      <p class="text-body store-card-address"><%= street %></p>
    <% end %>
    <p class="text-body store-card-copy line-clamp-3">
      <%= business.description&.to_plain_text %>
    </p>
    <%= link_to "Mehr erfahren",
    marketing_store_path(business),
    class: "link-more store-card-cta hover:underline" %>
  </div>
</div>
