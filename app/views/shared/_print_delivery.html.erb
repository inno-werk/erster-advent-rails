<section class="mt-8 border-t border-base-content/10 pt-5 text-sm text-base-content/65" aria-labelledby="print-delivery-heading">
  <h2 id="print-delivery-heading" class="font-semibold text-base-content/80 mb-2">Verteilung und Lieferung</h2>
  <% distribution = PrintDistribution.current %>
  <% if (date = distribution.distribution_on) %>
    <p>Die Printmaterialien werden am <time datetime="<%= date.iso8601 %>"><%= l(date, locale: :de, format: "%A, %-d.%m.") %></time>, verteilt.</p>
  <% else %>
    <p>Das Datum wird noch bekannt gegeben.</p>
  <% end %>
  <% if (deadline = distribution.order_deadline_on) %>
    <p class="mt-2">Bestellungen müssen bis am <time datetime="<%= deadline.iso8601 %>"><%= l(deadline, format: "%-d.%m.") %></time> eingehen.</p>
  <% else %>
    <p class="mt-2">Der Bestellschluss wird noch bekannt gegeben.</p>
  <% end %>
</section>
