<% content_for :email_preview_in_content, "true" %>
<section class="flex flex-1 items-center justify-center bg-primary px-6 py-16" data-confirmation-panel>
  <div class="w-full max-w-xl rounded-3xl bg-base-100 px-8 py-12 text-center shadow-xl">
    <%= heroicon "envelope", options: { class: "mx-auto mb-6 h-10 w-10 text-primary" } %>
    <h1 class="text-3xl font-semibold">E-Mail-Adresse bestätigen</h1>
    <% if account_email_preview_available? %>
      <div data-controller="email-preview-notice" data-email-preview-notice-id-value="<%= account_email_preview_notice_id %>">
        <div data-email-preview-notice-target="prompt" <%= "hidden" if account_email_preview_opened? %>>
          <p class="mt-4 text-base-content/70">Ihre Bestätigungs-E-Mail ist bereit. Öffnen Sie die Vorschau und bestätigen Sie dort Ihre E-Mail-Adresse, um fortzufahren.</p>
          <div class="mt-6">
            <%= link_to "E-Mail-Vorschau öffnen", email_preview_path, target: "_blank", rel: "noopener noreferrer", class: "btn btn-primary", data: { turbo: false } %>
            <p class="mt-3 text-sm text-base-content/60">Öffnet in einem neuen Tab. Es wurde keine E-Mail versendet.</p>
          </div>
        </div>
        <div data-email-preview-notice-target="opened" <%= "hidden" unless account_email_preview_opened? %>>
          <p class="mt-4 text-base-content/70" role="status">Die E-Mail-Vorschau wurde geöffnet. Bestätigen Sie Ihre E-Mail-Adresse im neuen Tab, um fortzufahren.</p>
          <%= link_to "Vorschau erneut öffnen", email_preview_path, target: "_blank", rel: "noopener noreferrer", class: "link mt-4 inline-block text-sm", data: { turbo: false } %>
        </div>
      </div>
    <% elsif account_email_preview_retryable? %>
      <p class="mt-4 text-base-content/70" role="status">Ihre Registrierung wurde gespeichert. Die E-Mail-Vorschau ist gerade nicht verfügbar. Bitte fordern Sie die Bestätigung erneut an.</p>
    <% elsif AccountEmailPreview.enabled? %>
      <p class="mt-4 text-base-content/70">Im Testmodus werden keine E-Mails versendet. Eine Vorschau ist nur für ein in diesem Browser neu registriertes Testkonto während 30 Minuten verfügbar.</p>
    <% elsif !EmailDelivery.enabled? %>
      <p class="mt-4 text-base-content/70">Der E-Mail-Versand ist derzeit deaktiviert. Bitte kontaktieren Sie uns, damit wir Ihnen bei der Aktivierung Ihres Kontos helfen können.</p>
    <% else %>
      <p class="mt-4 text-base-content/70">Bitte öffnen Sie die Bestätigungs-E-Mail und klicken Sie auf «E-Mail-Adresse bestätigen», um Ihre Teilnahme einzurichten.</p>
      <p class="mt-3 text-sm text-base-content/60">Keine E-Mail erhalten? Prüfen Sie auch Ihren Spam-Ordner.</p>
    <% end %>
    <%= link_to "Bestätigung erneut anfordern", new_user_confirmation_path, class: "link mt-6 inline-block text-sm" %>
  </div>
</section>
